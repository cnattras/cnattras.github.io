#!/bin/perl
$jobID =$ARGV[0];
$dir = `pwd`;
chomp($dir);
print "Job ID $jobID\n";
print "Working directory $dir\n";
$test = "ls $dir"."/root*/*"."$jobID"."_?.root";
#print "$test\n";
#die;
@files = `$test`;
$nfiles = $#files;
#print "$nfiles files to resubmit\n";
$nEvents = 0;
for($i=0;$i<=$nfiles;$i++){  
  chomp($files[$i]);
  $command = "root4star -b -q eventcount.C\'(\"$files[$i]\")\'";
  @test = `$command`;
  $ntest = $#test;
  for($j=0;$j<=$ntest;$j++){  
    if($test[$j] =~ "events"){
      #print "$test[$j]\n";
      ($neve,$garb) = split(" ",$test[$j]);
      #print "Events: $neve\n";
      $nEvents += $neve;
    }
  }
  print "$command\n";
}

