\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Sample correlations for $3.0$ $<$ $p_T^{trigger}$ $<$ $6.0$ GeV/c\xspace  and $1.5$ GeV/c $<$ $p_T^{associated}$ $<$ $p_T^{trigger}$\xspace  for 0-10\% centrality for (a) $Cu+Cu$\xspace  at $\sqrt  {s_{NN}}$ = 62 GeV\xspace  (b) $Au+Au$\xspace  at $\sqrt  {s_{NN}}$ = 62 GeV\xspace  (c) $Cu+Cu$\xspace  at $\sqrt  {s_{NN}}$ = 200 GeV\xspace  and (d) $Au+Au$\xspace  at $\sqrt  {s_{NN}}$ = 200 GeV\xspace  . The dependence of the jet-like correlation\xspace  is shown as a function of $\Delta \phi $\xspace  in open symbols and $\Delta \eta $\xspace  in closed symbols. Color online.}}{3}{}}
\newlabel{Figure1a}{{1}{3}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Inverse slope parameter k (MeV/c\xspace  ) of $p_T^{associated}$\xspace  for fits of data in Figure\nobreakspace  {}4{}{}{}\hbox {}. The inverse slope parameter from a fit to $\pi ^-$ in $Au+Au$\xspace  from \cite  {Pion} above 1.0 GeV/c\xspace  is $k$ = 280.9 $\pm $ 0.4 MeV/c\xspace  for $\sqrt  {s_{NN}}$ = 62 GeV\xspace  and is $k$ = 330.9 $\pm $ 0.3 MeV/c\xspace  for $\sqrt  {s_{NN}}$ = 200 GeV\xspace  . Statistical errors only.}}{3}{}}
\newlabel{Table}{{I}{3}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Sample correlations for $3.0$ $<$ $p_T^{trigger}$ $<$ $6.0$ GeV/c\xspace  and $1.5$ GeV/c $<$ $p_T^{associated}$ $<$ $p_T^{trigger}$\xspace  for 0-10\% centrality for (a) $Cu+Cu$\xspace  at $\sqrt  {s_{NN}}$ = 62 GeV\xspace  (b) $Au+Au$\xspace  at $\sqrt  {s_{NN}}$ = 62 GeV\xspace  (c) $Cu+Cu$\xspace  at $\sqrt  {s_{NN}}$ = 200 GeV\xspace  and (d) $Au+Au$\xspace  at $\sqrt  {s_{NN}}$ = 200 GeV\xspace  . Lines show the background using the ZYAM method with the range of $v_2$\xspace  used for the determination of the systematic errors.}}{4}{}}
\newlabel{Figure1b}{{2}{4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Dependence of jet-like correlation\xspace  yield on $p_T^{trigger}$\xspace  . The yield is nearly independent of collision system and is consistent with the $d+Au$\xspace  . The shape of the dependence on $p_T^{trigger}$\xspace  is well described by PYTHIA\xspace  . Color online.}}{4}{}}
\newlabel{Figure1}{{3}{4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Dependence of jet-like correlation\xspace  yield on $p_T^{associated}$\xspace  . The key is the same as in figure\nobreakspace  {}3{}{}{}\hbox {}. The yield is nearly independent of collision system and is consistent with the $d+Au$\xspace  . The spectrum from PYTHIA\xspace  is slightly harder, which may explain why the $p_T^{trigger}$\xspace  dependence must be scaled. Color online.}}{4}{}}
\newlabel{Figure2}{{4}{4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Dependence of jet-like correlation\xspace  yield on $N_{part}$\xspace  . The jet-like correlation\xspace  yield in $Cu+Cu$\xspace  and $Au+Au$\xspace  are within error at both $\sqrt  {s_{NN}}$ = 62 GeV\xspace  and $\sqrt  {s_{NN}}$ = 200 GeV\xspace  . There is a slight increase with $N_{part}$\xspace  . This may be attributed to the method. If the ridge\xspace  is not completely independent of $\Delta \eta $\xspace  it would contribute more to the yield at high $N_{part}$\xspace  . The yield at $\sqrt  {s_{NN}}$ = 62 GeV\xspace  is about 40\% lower than at $\sqrt  {s_{NN}}$ = 200 GeV\xspace  . This would be expected if the jet-like correlation\xspace  were primarily from fragmentation. Color online.}}{4}{}}
\newlabel{Figure3}{{5}{4}{}{}{}}
