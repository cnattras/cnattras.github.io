\begin{center}
\caption[\vzero center parameters]{\vzero center fit parameters from fit of data in \Fref{V0Center} to $A e^{-(b/p_{T})^c}$.}\label{TableV0Centers}
\begin{tabular}{c|c c c}
\hline
particle & a & b & c \\ \hline
\lam & 1116.25 $\pm$ 0.02 & 3.9 $\cdot 10^{-4}$ $\pm$ 0.4 $\cdot 10^{-4}$ & 0.86 $\pm$ 0.01 \\
\alam & 1116.03 $\pm$ 0.02 & 2.4 $\cdot 10^{-3}$ $\pm$ 0.3 $\cdot 10^{-3}$ & 1.16 $\pm$ 0.03 \\
\kaon & 501.5 $\pm$ 0.2 & 1.7 $\cdot 10^{-4}$ $\pm$ 0.3 $\cdot 10^{-4}$ & 0.50 $\pm$ 0.02 \\
