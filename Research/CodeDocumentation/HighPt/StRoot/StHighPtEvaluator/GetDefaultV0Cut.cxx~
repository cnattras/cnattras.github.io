#include "GetDefaultV0Cut.h"
//This is the only function which actually needs to get written.  The rest are permutations of this.


float GetDefaultV0Cut(char *dataset, char *type, char *cut, int partID){
  //cerr<<"|1";
  //cuts will default to the loosest cuts if no data set is specified or if an invalid one is specified or if one whose cuts haven't been defined specifically
  //if no type is defined or it is not a valid type defaults will be TTree cuts
  //if no cut is specified the returned value will be -1
  string myCut = cut;
  string DecayLength = "DecayLength";
  string DcaV0ToPV = "DcaV0ToPV";
  string DcaDaughters = "DcaDaughters";
  string DcaNegToPV = "DcaNegToPV";
  string DcaPosToPV = "DcaPosToPV";
  string NHitsPos = "NHitsPos";
  string NHitsNeg = "NHitsNeg";
  if(myCut != DecayLength && myCut != DcaV0ToPV && myCut != DcaDaughters && myCut != DcaNegToPV && myCut != DcaPosToPV && myCut != NHitsPos && myCut != NHitsNeg){
    //cerr<<"GetDefaultV0Cut : "<<myCut<<" is not a valid cut. Returning -1.0"<<endl;
    return -1.0;
  }
  string myDataSet = dataset;
  string AuAu200 = "AuAu200";
  string AuAu200Y2 = "AuAu200Y2";
  string dAu200 = "dAu200";
  string CuCu200 = "CuCu200";
  string CuCu62 = "CuCu62";
  string AuAu62 = "AuAu62";
  string cutType = type;
  string TTree = "TTree";
  string Correlation = "Correlation";
  string Spectra = "Spectra";//This is written into this but it's not actually going to point to a separate set of cuts unless someone writes them.
  float decayLength = 0.;
  float dcaV0ToPV = 100.;
  float dcaDaughters = 100.;
  float dcaNegToPV = 0.0;
  float dcaPosToPV = 0.0;
  //These are written as floats.  The user must type cast them to be ints
  float nHitsPos = 15;
  float nHitsNeg = 15;
  if(dataset == AuAu200 || dataset == AuAu200Y2){
    if(cutType == TTree){
      decayLength=2.0; // was 2.0, 5.0 , 6.0 for AuAu minbias
      dcaV0ToPV=2.0; //was 2.0 0.5
      dcaDaughters=1.0; //was 0.75
      nHitsNeg=nHitsPos=15;
      if(partID==1 || partID ==2 ) {
	dcaNegToPV=0.0;
	dcaPosToPV=0.0;
      }
      if(partID==3) {
	dcaNegToPV=0.6;
	dcaPosToPV=0.6;
      }      
    }
    if(cutType == Correlation){  
      if(partID==1) {
	dcaNegToPV=1.2;
	dcaPosToPV=0.7;
	dcaDaughters=0.6;
	dcaV0ToPV=0.6;
	decayLength=12.0;
	nHitsNeg=15;
	nHitsPos=20;
      }
      if(partID==2) {
	dcaNegToPV=0.7;
	dcaPosToPV=1.2;
	dcaDaughters=0.6;
	dcaV0ToPV=0.6;
	decayLength=12.0;
	nHitsNeg=20;
	nHitsPos=15;
      }
      if(partID==3) {
	dcaNegToPV=1.2;
	dcaPosToPV=1.2;
	dcaDaughters=0.6;
	dcaV0ToPV=0.6;
	decayLength=10.0;
	nHitsNeg=20;
	nHitsPos=20;
      }
      
    }
  }
  if(dataset == CuCu200){
    if(cutType == TTree){//TTree cuts default to the loosest in the production
    }
    if(cutType == Correlation){//Correlation cuts
      //Only four cuts were tightened for correlations
      if(partID == 1){dcaNegToPV = 1.0;}//lambdas
      if(partID == 2){dcaPosToPV = 1.0;}//antilambdas
      if(partID == 3){
	dcaV0ToPV = 4.;
	dcaDaughters = .4;
	decayLength = 3.;
      }
    }
  }



  if(myCut == DecayLength){return decayLength;}
  if(myCut == DcaV0ToPV){return dcaV0ToPV;}
  if(myCut == DcaDaughters){return dcaDaughters;}
  if(myCut == DcaNegToPV){return dcaNegToPV;}
  if(myCut == DcaPosToPV){return dcaPosToPV;}
  if(myCut == NHitsPos){return nHitsPos;}
  if(myCut == NHitsNeg){return nHitsNeg;}
  //if all else fails:
  //cerr<<"GetDefaultV0Cut : One of your parameters failed.  It may have been: data set = "<<dataset<<" cut type = "<<cut<<" partID = "<<partID<<".  Returning -1.0"<<endl;
  return -1.0;
}
float GetDefaultV0Cut(char *dataset, char *type, string cut, int partID){
  //cerr<<"|2";
  return GetDefaultV0Cut( dataset, type, (char*)cut.c_str(), partID);
}
