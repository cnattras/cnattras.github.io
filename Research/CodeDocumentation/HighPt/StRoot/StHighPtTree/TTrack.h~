class TTrack : public TObject {

private:
  //   Float_t      fPx;           //X component of the momentum
  //  Float_t      fPy;           //Y component of the momentum
  //  Float_t      fPz;           //Z component of the momentum
   Float_t      fPt;           // transverse momentum
   //  Float_t      fMass;        // The mass of this particle
   Float_t      fPhi;         // azimuthal angle
   Float_t      fEta;         // eta
   Int_t        fCharge;       //Charge of this track
   Int_t        fType;         //Particle type: 1 charged particle, 2 lambda, 3 antilambda
   Int_t        fNHits;       //Number of hits on track for this track
   Int_t fNPossHits;         //Possible number of hits, added on January 19, 2006
   Float_t      fdEdx;        // measured dEdx added on January 19,2006
