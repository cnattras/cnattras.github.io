   Int_t        fTrackId;

public:
   TTrack() { };
   TTrack(const TTrack* orig);
   virtual ~TTrack() {Clear();}
   void          Clear(Option_t *option="") { }
   // Float_t       GetPx() const { return fPx; }
   //  Float_t       GetPy() const { return fPy; }
   // Float_t       GetPz() const { return fPz; }
   Float_t       GetPt() const { return fPt; }
   Float_t       GetPhi() const { return fPhi; }
   Float_t       GetEta() const { return fEta; }
   // Float_t       GetMass() const { return fMass; }
   Int_t         GetCharge() const { return fCharge; }
   Int_t         GetType() const { return fType;}
   Int_t         GetNHits() const { return fNHits; }
   Int_t         GetNPossHits() const { return fNPossHits; }
   Float_t       GetdEdx() const {return fdEdx;}
   // Float_t       GetDca()  const {return fDca;}
   Int_t         GetTrackId() const {return fTrackId;}

   // was GetNpoints, SetNpoints

   //    void    SetPx(Float_t x)     { fPx = x;       }         
   //  void    SetPy(Float_t x)     { fPy = x;       }               
   //  void    SetPz(Float_t x)     { fPz = x;       }
    void    SetPt(Float_t x)     { fPt = x;       }
    void    SetPhi(Float_t x)    { fPhi = x;      }
    void    SetEta(Float_t x)    { fEta = x; }
    //   void    SetMass(Float_t x)   { fMass = x; }
    void    SetCharge(Int_t x)   { fCharge = x;   }
    void    SetType(Int_t x) { fType = x;}
    void    SetNHits(Int_t x)   { fNHits = x;   }
    void    SetNPossHits(Int_t x)   { fNPossHits = x;   }
    void    SetdEdx(Float_t x) { fdEdx = x;}
    // void    SetDca(Float_t x) { fDca = x;}
    void    SetTrackId(Int_t x) {fTrackId = x;}
    //    void    SetTrackId(UInt_t x) { fTrackId = x;  }                      
    
  

   ClassDef(TTrack,1)  //A track segment
