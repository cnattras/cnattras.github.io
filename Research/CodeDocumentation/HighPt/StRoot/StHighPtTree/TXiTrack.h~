#ifndef TV0Track_h
#define TV0Track_h
//////////////////////////////////////////////////////////////////////////
//                                                                      //
// TV0Track                                                             //
//                                                                      //
// Description of the event           parameters                        //
//                                                                      //
//////////////////////////////////////////////////////////////////////////

#include "TObject.h"
#include "TClonesArray.h"
#include "TRefArray.h"
#include "TRef.h"
#include "TMath.h"


class TV0Track : public TObject {

private:
   Float_t      fPx;           //X component of the momentum
   Float_t      fPy;           //Y component of the momentum
   Float_t      fPz;           //Z component of the momentum
   Float_t      fPt;           // transverse momentum
   Float_t      fMass;        // The mass of this particle
   Float_t      fPhi;         // azimuthal angle
   Int_t        fCharge;       //Charge of the particle
   Int_t        fType;         //Particle type: 0 charged particle, 1 lambda, 2 antilambda, 3 K0s
   Float_t      fRapidity;
   Float_t      fPseudoRapidity;
   Float_t      fDecayLength;
   Float_t      fDcaPosDaughterToPV;
   Float_t      fDcaNegDaughterToPV;
   Float_t      fDcaV0ToPV;
   Float_t      fDcaDaughters;
   Int_t        fNHitsPosDaughter;
   Int_t        fNHitsNegDaughter;
   Float_t      fdEdxPosDaughter;
   Float_t      fdEdxNegDaughter;
   Int_t        fPosDaughterTrackId;
   Int_t        fNegDaughterTrackId;

   //helix stuff
   Double_t fCurvaturePos;
   Double_t fDipAnglePos;
   Double_t fPhasePos;
   Double_t fOrigXPos;
   Double_t fOrigYPos;
   Double_t fOrigZPos;
   Int_t fHPos;

   Double_t fCurvatureNeg;
   Double_t fDipAngleNeg;
   Double_t fPhaseNeg;
   Double_t fOrigXNeg;
   Double_t fOrigYNeg;
   Double_t fOrigZNeg;
   Int_t fHNeg;

   
public:
   TV0Track() { }
   TV0Track(const TV0Track* orig);
   virtual ~TV0Track() {Clear();}
   void     Clear(Option_t *option="") { }
   Float_t  GetPx() const { return fPx; }
   Float_t  GetPy() const { return fPy; }
   Float_t  GetPz() const { return fPz; }
   Float_t  GetPt() const { return fPt; }
   Float_t  GetPhi() const { return fPhi; }
   Float_t  GetMass() const { return fMass; }
   Int_t    GetCharge() const { return fCharge; }
   Int_t    GetType() const { return fType;}
   Float_t  GetEta() const { return fPseudoRapidity;}
   Float_t  GetRapidity() const { return fRapidity;}
   Float_t  GetDecayLength() const { return fDecayLength;}
   Float_t  GetDcaPosDaughterToPV() const   {  return fDcaPosDaughterToPV;}
   Float_t  GetDcaNegDaughterToPV() const    {  return fDcaNegDaughterToPV;}
   Float_t  GetDcaV0ToPV() const   { return fDcaV0ToPV;}
   Float_t  GetDcaDaughters() const   { return fDcaDaughters;}
   Int_t    GetNHitsPosDaughter()  const { return fNHitsPosDaughter;}
   Int_t    GetNHitsNegDaughter()  const {  return fNHitsNegDaughter;}
   Float_t  GetdEdxPosDaughter() const  { return fdEdxPosDaughter;}
   Float_t  GetdEdxNegDaughter() const  { return fdEdxNegDaughter;}
   Int_t    GetPosDaughterTrackId() const { return  fPosDaughterTrackId;}
   Int_t    GetNegDaughterTrackId() const { return  fNegDaughterTrackId;}

   //helix stuff
   Double_t GetCurvaturePos() const { return fCurvaturePos;}
   Double_t GetDipAnglePos() const  { return fDipAnglePos;}
   Double_t GetPhasePos() const  { return fPhasePos;}
   Double_t GetOrigXPos() const  { return fOrigXPos;}
   Double_t GetOrigYPos() const  { return fOrigYPos;}
   Double_t GetOrigZPos() const  { return fOrigZPos;}
   Int_t GetHPos() const  { return fHPos;}

   Double_t GetCurvatureNeg() const  { return fCurvatureNeg;}
   Double_t GetDipAngleNeg() const  { return fDipAngleNeg;}
   Double_t GetPhaseNeg() const  { return fPhaseNeg;}
   Double_t GetOrigXNeg() const  { return fOrigXNeg;}
   Double_t GetOrigYNeg() const { return fOrigYNeg;}
   Double_t GetOrigZNeg() const  { return fOrigZNeg;}
   Int_t GetHNeg() const  { return fHNeg;}

   void    SetPx(Float_t x)     { fPx = x;       }         
   void    SetPy(Float_t x)     { fPy = x;       }               
   void    SetPz(Float_t x)     { fPz = x;       }
   void    SetPt(Float_t x)     { fPt = x;       }
   void    SetPhi(Float_t x)    { fPhi = x;      }
   void    SetMass(Float_t x)   { fMass = x; }
   void    SetCharge(Int_t x)   { fCharge = x;   }
   void    SetType(Int_t x) { fType = x;}
   void    SetEta(Float_t x) {fPseudoRapidity = x;}
   void    SetRapidity(Float_t x) {fRapidity = x;}
   void    SetDecayLength(Float_t x) { fDecayLength=x;}
   void    SetDcaPosDaughterToPV(Float_t x)  {fDcaPosDaughterToPV = x;}
   void    SetDcaNegDaughterToPV(Float_t x)   {fDcaNegDaughterToPV = x;}
   void    SetDcaV0ToPV(Float_t x)  {fDcaV0ToPV = x;}
   void    SetDcaDaughters(Float_t x)  {fDcaDaughters = x;}
   void    SetNHitsPosDaughter(Int_t x) {fNHitsPosDaughter = x;}
   void    SetNHitsNegDaughter(Int_t x) {fNHitsNegDaughter = x;}
   void    SetdEdxPosDaughter(Float_t x) {fdEdxPosDaughter = x;}
   void    SetdEdxNegDaughter(Float_t x) {fdEdxNegDaughter = x;}
   void    SetPosDaughterTrackId(Int_t x) {fPosDaughterTrackId = x;}
   void    SetNegDaughterTrackId(Int_t x) {fNegDaughterTrackId = x;}

   //helix stuff
   void SetCurvaturePos(Double_t x) {fCurvaturePos =x;}
   void SetDipAnglePos(Double_t x) {fDipAnglePos =x;}
   void SetPhasePos(Double_t x) {fPhasePos =x;}
   void SetOrigXPos(Double_t x) {fOrigXPos =x;}
   void SetOrigYPos(Double_t x) {fOrigYPos =x;}
   void SetOrigZPos(Double_t x) {fOrigZPos =x;}
   void SetHPos(Int_t x) {fHPos =x;}

   void SetCurvatureNeg(Double_t x) {fCurvatureNeg =x;}
   void SetDipAngleNeg(Double_t x) {fDipAngleNeg =x;}
   void SetPhaseNeg(Double_t x) {fPhaseNeg =x;}
   void SetOrigXNeg(Double_t x) {fOrigXNeg =x;}
   void SetOrigYNeg(Double_t x) {fOrigYNeg =x;}
   void SetOrigZNeg(Double_t x) {fOrigZNeg =x;}
   void SetHNeg(Int_t x) {fHNeg =x;}
   

   ClassDef(TV0Track,1)  //Event structure
};
#endif

