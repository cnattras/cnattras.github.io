#include "TResonanceTrack.h"

ClassImp(TResonanceTrack)

TResonanceTrack::TResonanceTrack(const TResonanceTrack* orig) : TTrack(orig){
  //copy negative track variables:
  SetNHitsNeg(orig->GetNHitsNeg());
  SetNPossHitsNeg(orig->GetNPossHitsNeg());
  SetdEdxNeg(orig->GetdEdxNeg());
  SetTrackIdNeg(orig->GetTrackIdNeg());
  //positive track variables ok from TTrack method

  SetMass(orig->GetMass());
  SetOpeningAngle(orig->GetOpeningAngle());
}
