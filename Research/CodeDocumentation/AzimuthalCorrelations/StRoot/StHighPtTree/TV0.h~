#include "TObject.h"
#include "TClonesArray.h"
#include "TRefArray.h"
#include "TRef.h"
#include "TMath.h"

class TV0Track;


class TV0 : public TObject {


 private:
  Int_t          fNtrack;            //Number of V0 tracks
  TClonesArray  *fV0Tracks;               //->array with all V0 tracks
  TRefArray     *fLambdas;                //array of Lambda tracks only
  TRefArray     *fAntiLambdas;            //array of Anti-Lambda tracks only
  TRefArray     *fK0short;                //array of K0-short tracks only
  TRef           fLastTrack;         //reference pointer to last track

  static TClonesArray *fgV0Tracks;

 public:
   TV0();
   virtual ~TV0();
   void          SetNtrack(Int_t n) { fNtrack = n; }
   void          Clear(Option_t *option ="");
   static void   Reset(Option_t *option ="");
   TV0Track      *AddV0Track(TV0Track*,Float_t, Int_t);

   TClonesArray *GetV0s() const {return fV0Tracks;}
   TRefArray    *GetLambdas() const {return fLambdas;}
   TRefArray    *GetAntiLambdas() const {return fAntiLambdas;}
   TRefArray    *GetK0short() const {return fK0short;}
   TV0Track     *GetLastTrack() const {return (TV0Track*)fLastTrack.GetObject();}


   ClassDef(TV0,1)  //V0 structure
};


