float efficiency(const char *dataset, float pt, int multiplicity){
  string myDataSet = dataset;
  string AuAu200 = "AuAu200";
  string CuCu200 = "CuCu200";
  string AuAu62 = "AuAu62";
  float efficiency = 1;
  int centbin = centrality(dataset,multiplicity);
  if(centbin == -1){
    cerr<<"efficiency: can't calculate efficiency because the multiplicity "<<multiplicity<<" is not a valid multiplicity for the dataset "<<dataset<<endl;
    return 100000.;
  }


  if(dataset == AuAu200){
    float parameters[11][3]={0.0,0.0,0.0,
			     .767,.1498,1.316,
			     .7856,.1419,1.33,
			     .7975,.1408,1.464,
			     .8113,.1374,1.606,
			     .822,.1376,1.743,
			     .8321,.1327,1.781,
			     .8386,.1357,1.912,
			     .8387,.1511,2.381,
			     .8415,.1455,2.153,
			     1.0,0,1.0};
    efficiency=parameters[centbin][0]*exp(-pow(parameters[centbin][1]/pt,parameters[centbin][2]));
  }

  if(dataset == CuCu200){
    centbin = centrality("AuAu200",multiplicity);//temporary fix because efficiencies for CuCu200 aren't ready yet
    float parameters[11][3]={0.0,0.0,0.0,
			     .767,.1498,1.316,
			     .7856,.1419,1.33,
			     .7975,.1408,1.464,
			     .8113,.1374,1.606,
			     .822,.1376,1.743,
			     .8321,.1327,1.781,
			     .8386,.1357,1.912,
			     .8387,.1511,2.381,
			     .8415,.1455,2.153,
			     1.0,0,1.0};
    efficiency=parameters[centbin][0]*exp(-pow(parameters[centbin][1]/pt,parameters[centbin][2]));
  }

  return efficiency;
}


