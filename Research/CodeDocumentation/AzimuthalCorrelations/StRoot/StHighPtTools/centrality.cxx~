#  include "centrality.h"

int centrality(string dataset, int multiplicity){
  return centrality((char*) dataset.c_str(), multiplicity);
}
int centrality(const char *dataset, int multiplicity){
  string myDataSet = dataset;
  string AuAu200 = "AuAu200";
  string CuCu200 = "CuCu200";
  string AuAu62 = "AuAu62";
  int centBin=-1;
  if(dataset == AuAu200){
    if(multiplicity>=0  && multiplicity<14)   centBin=10;
    if(multiplicity>=14  && multiplicity<30)  centBin=9;
    if(multiplicity>=30  && multiplicity<56)  centBin=8;
    if(multiplicity>=56  && multiplicity<94)  centBin=7;
    if(multiplicity>=94  && multiplicity<146) centBin=6;
    if(multiplicity>=146 && multiplicity<217) centBin=5;
    if(multiplicity>=217 && multiplicity<312) centBin=4;
    if(multiplicity>=312 && multiplicity<431) centBin=3;
    if(multiplicity>=431 && multiplicity<510) centBin=2;
    if(multiplicity>=510)             centBin=1;
  }
  if(dataset == CuCu200){
    if(multiplicity>=0  && multiplicity<17)   centBin=7;//60-80%
    if(multiplicity>=17  && multiplicity<30)  centBin=6;//50%-60%
    if(multiplicity>=30  && multiplicity<47)  centBin=5;//40%-50%
    if(multiplicity>=47  && multiplicity<69)  centBin=4;//30%-40%
    if(multiplicity>=69  && multiplicity<98) centBin=3;//20%-30%
    if(multiplicity>=98 && multiplicity<138) centBin=2;//10%-20%
    if(multiplicity>=138) centBin=1;//0%-10%  
  }

  if(dataset == AuAu62){//Renumbered from Jana's numbering so it goes with the same theme as the others
    if(multiplicity>=0  && multiplicity<9)   centBin=10;
    if(multiplicity>=9   && multiplicity<20)  centBin=9;
    if(multiplicity>=20  && multiplicity<38)  centBin=8;
    if(multiplicity>=38  && multiplicity<65)  centBin=7;
    if(multiplicity>=65  && multiplicity<102) centBin=6;
    if(multiplicity>=102 && multiplicity<154) centBin=5;
    if(multiplicity>=154 && multiplicity<222) centBin=4;
    if(multiplicity>=222 && multiplicity<313) centBin=3;
    if(multiplicity>=313 && multiplicity<373) centBin=2;
    if(multiplicity>=373)             centBin=1;
  }
  return centBin;
}
