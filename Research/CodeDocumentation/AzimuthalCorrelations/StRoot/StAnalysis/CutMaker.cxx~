int CutMaker::GetCutNum(int partID){
  switch(partID){
  case 1:
    return 0;
  case 2:
    return 1;
  case 3:
    return 2;
  case 4:
    return 3;//Xi
  case 5:
    return 5;//Omega
  case 18:
    return 4;//antiXi
  case 19:
    return 6;//anti-Omega
  default:
    return -1;
  }
  return -1;
}


int CutMaker::GetArrayIndex(int partID){
  switch(partID){
  case 1:
    return 0;
  case 2:
    return 1;
  case 3:
    return 2;
  case 4:
    return 3;
  case 5:
    return 5;
  case 18:
    return 4;
  case 19:
    return 6;
  default:
    return -1;
  }
  return -1;
}
void CutMaker::SetDcaXiToPV(int partID, float cut){
  if( GetArrayIndex(partID) ==-1 ) {
    cerr<<"Error: "<<partID<<" not a valid particle id!"<<endl;
    return;
  }
  DcaXiToPV[ GetArrayIndex(partID) ] = cut;
}
